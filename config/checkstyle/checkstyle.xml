<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name = "Checker">
  <property name="charset" value="UTF-8"/>

  <property name="severity" value="error"/>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="TreeWalker">

    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="ImportOrder">
      <property name="option" value="bottom"/>
      <property name="separated" value="true"/>
      <property name="useContainerOrderingForStatic" value="true"/>
      <property name="groups" value="net.smyler.smylib,net.smyler.terramap,net.smyler,fr.thesmyler,net.buildtheearth.terraplusplus,java,javax,net.minecraft,net.minecraftforge,org.lwjgl,io.netty,org.apache.logging.log4j,com.google.gson,org.jetbrains.annotations,org.junit"/>
    </module>

    <module name="EmptyLineSeparator">
      <property name="tokens" value="PACKAGE_DEF, IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF, STATIC_INIT, INSTANCE_INIT, METHOD_DEF, CTOR_DEF, VARIABLE_DEF, RECORD_DEF, COMPACT_CTOR_DEF"/>
      <property name="allowNoEmptyLineBetweenFields" value="true"/>
      <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
    </module>
    <module name="WhitespaceAround">
      <property name="tokens" value="LITERAL_IF, LITERAL_FOR, LITERAL_WHILE, LITERAL_TRY, LITERAL_CATCH, LITERAL_ELSE, LITERAL_SWITCH, ASSIGN, STAR, STAR_ASSIGN, DIV, DIV_ASSIGN, COLON, QUESTION, PLUS, PLUS_ASSIGN, MINUS, MINUS_ASSIGN"/>
    </module>

  </module>

</module>
